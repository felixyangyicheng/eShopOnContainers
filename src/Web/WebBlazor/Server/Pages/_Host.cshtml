@page "/"
@namespace WebBlazor.Server.Pages
@*@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using WebBlazor.Client*@
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@{
    var pathBase = Configuration["PATH_BASE"];
    if (string.IsNullOrEmpty(pathBase)) pathBase = "/";
    else if (!pathBase.EndsWith("/")) pathBase = $"{pathBase}/";
}

<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>eShopOnContainers - WebBlazor SPA</title>
    <base href="@pathBase" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="css/site.min.css" rel="stylesheet" />
    <link href="WebBlazor.Client.styles.css" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
</head>
<body>
    <app>
        Loading...
        <div class="preloading">
            <i class="fa fa-spinner fa-spin fa-5x" aria-hidden="true"></i>
        </div>
        @*<component type="typeof(App)" render-mode="WebAssemblyPrerendered" />*@
    </app>
    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>
    <script src="_content/Microsoft.AspNetCore.Components.WebAssembly.Authentication/AuthenticationService.js"></script>
    <script src="_framework/blazor.webassembly.js"></script>
    <script src="scripts/site.min.js"></script>
</body>
</html>
