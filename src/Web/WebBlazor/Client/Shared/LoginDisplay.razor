<div class="esh-identity">
    <AuthorizeView>
        <NotAuthorized>

            <section class="esh-identity-section">
                <div class="u-cursor-pointer pt-2 pb-2" @onclick="BeginSignIn">
                    <div class="esh-identity-name d-flex align-items-center">LOGIN
                        <img class="esh-identity-image ml-2" src="assets/images/user.svg">
                    </div>
                </div>
            </section>

        </NotAuthorized>
        <Authorized>

            <section class="esh-identity-section u-cursor-pointer pt-2 pb-2">
                <div class="esh-identity-name">@context.User.GetPreferredUsername()</div>
                <img class="esh-identity-image ml-1" src="assets/images/user.svg">
            </section>

            <section class="esh-identity-drop">
                <div class="esh-identity-item" href="orders">
                    <div class="esh-identity-name">My orders</div>
                </div>
                @*<div class="esh-identity-item">
                    <a class="esh-identity-name esh-identity-name--upper" href="campaigns">Campaigns</a>
                    <img class="esh-identity-image" src="assets/images/my_orders.png">
                </div>*@
                <div class="esh-identity-item" @onclick="BeginSignOut">
                    <div class="esh-identity-name">Log Out</div>
                </div>
            </section>

        </Authorized>
    </AuthorizeView>
</div>
