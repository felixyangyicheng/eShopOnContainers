@page "/ordersnew"

<div class="mb-5">
    <div class="container">
        <h1 class="mb-4 mt-5">[ Checkout ]</h1>
        <div class="alert" role="alert" hidden="@(!errorReceived)">
            Not possible to create a new order, please try later on
        </div>
        <EditForm EditContext="@editContext" OnSubmit="@SubmitForm">
            <DataAnnotationsValidator />
            <section class="u-background-brightest p-5">
                <h2 class="mb-4">Shipping Address</h2>
                <div class="row">
                    <div class="col-6">
                        <div class="form-group"> @*@ErrorClass(() => order.Street)*@
                            <label>Address</label>
                            <InputText class="form-control form-input w-100 u-maxwidth-unset" placeholder="Street" @bind-Value="order.Street" />
                            <ValidationMessage For="() => order.Street" />
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group"> @*@ErrorClass(() => order.City)*@
                            <label>City</label>
                            <InputText class="form-control form-input w-100 u-maxwidth-unset" placeholder="City" @bind-Value="order.City" />
                            <ValidationMessage For="() => order.City" />
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group"> @*@ErrorClass(() => order.State)*@
                            <label>State</label>
                            <InputText class="form-control form-input w-100 u-maxwidth-unset" placeholder="State" @bind-Value="order.State" />
                            <ValidationMessage For="() => order.State" />
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group"> @*@ErrorClass(() => order.Country)*@
                            <label>Country</label>
                            <InputText class="form-control form-input w-100 u-maxwidth-unset" placeholder="Country" @bind-Value="order.Country" />
                            <ValidationMessage For="() => order.Country" />
                        </div>
                    </div>
                </div>
                <h2 class="mt-5 mb-4">Payment method</h2>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group"> @*@ErrorClass(() => order.CardNumber)*@
                            <label>Card number</label>
                            <InputText class="form-control form-input w-100 u-maxwidth-unset" placeholder="000000000000000" @bind-Value="order.CardNumber" />
                            <ValidationMessage For="() => order.CardNumber" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group"> @*@ErrorClass(() => order.CardHolderName)*@
                            <label>Cardholder name</label>
                            <InputText class="form-control form-input w-100 u-maxwidth-unset" placeholder="Card holder" @bind-Value="order.CardHolderName" />
                            <ValidationMessage For="() => order.CardHolderName" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group"> @*@ErrorClass(() => order.CardExpirationShort)*@
                            <label>Expiration date</label>
                            <InputText class="form-control form-input w-50 u-maxwidth-unset" placeholder="MM/YY" @bind-Value="order.CardExpirationShort" />
                            <ValidationMessage For="() => order.CardExpirationShort" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group"> @*@ErrorClass(() => order.CardSecurityNumber)*@
                            <label class="esh-orders_new-title">Security code</label>
                            <InputText class="form-control form-input w-50 u-maxwidth-unset" placeholder="000" @bind-Value="order.CardSecurityNumber" />
                            <ValidationMessage For="() => order.CardSecurityNumber" />
                        </div>
                    </div>
                </div>

                <h2 class="mt-5 mb-4">Order details</h2>
                @foreach (var item in order.OrderItems)
                {
                    <article class="divider divider--bottom d-flex align-items-center pb-3 mt-3 u-text-sm">
                        <div class="esh-orders_new-thumbnail-container">
                            <div class="esh-orders_new-thumbnail-wrapper">
                                <img class="esh-orders_new-thumbnail" src="@item.PictureUrl">
                            </div>
                        </div>
                        <div class="row w-100 ml-3">
                            <div class="col-6">@item.ProductName</div>
                            <div class="col-2">$ @item.UnitPrice.ToString("N2")</div>
                            <div class="col-2">@item.Units</div>
                            <div class="col-2 text-right">$ @Math.Round(item.Units * item.UnitPrice, 2).ToString("N2")</div>
                        </div>
                    </article>
                }

                <div class="divider d-flex align-items-center justify-content-end mb-4 pt-4 text-uppercase u-text-xl">
                    <div>Total</div>
                    <div class="ml-3">$@order.Total.ToString("N2")</div>
                </div>

                <div class="esh-orders_new-buttons d-flex justify-content-end align-items-center">
                    <a class="btn btn-secondary" href="basket">Back to basket</a>

                    <button class="btn btn-primary ml-3" disabled="@CantPlaceOrder">Place Order</button>
                </div>
            </section>
        </EditForm>
    </div>
</div>
