@page "/ordersmanagement"

<div class="mb-5">
    <div class="esh-orders">
        <div class="container">
            <h1 class="mb-4 mt-5">[ Order Management ]</h1>
            <div class="esh-orders-alert alert" role="alert" hidden="@(!errorReceived)">
                Error requesting order list, please try later on
            </div>

            <div class="esh-orders-wrapper">
                <article class="esh-orders-titles row">
                    <section class="col-1"></section>
                    <section class="col-3">Date</section>
                    <section class="col-2">Total</section>
                    <section class="col-2">Status</section>
                    <section class="col-4"></section>
                </article>

                @foreach (var order in orders)
                {
                    <article class="esh-orders-item divider row">
                        <section class="col-1">@order.OrderNumber</section>
                        <section class="col-3">@order.Date.ToString("M/d/yy, h:mm tt")</section>
                        <section class="col-2">$@order.Total.ToString("N2")</section>
                        <section class="col-2">@order.Status</section>
                        <section class="col-4 d-flex align-items-center justify-content-center">
                            <select @onchange="e => OrderProcess(order.OrderNumber, e)" disabled=@(order.Status != "paid")>
                                <option value="">&nbsp;&nbsp;Select Action</option>
                                <option value="">------------------</option>
                                @foreach (var option in order.ActionCodeSelectList)
                                {
                                    <option value="@option.Code">@option.Name</option>
                                }
                            </select>
                        </section>
                    </article>
                }

                <aside class="d-flex justify-content-end mt-5 pr-5">
                    <a class="btn btn-secondary" href="orders">Back to list</a>
                </aside>
            </div>

            <div class="esh-orders-alert alert" role="alert" hidden="@(errorMessage == null)">
                @errorMessage
            </div>
        </div>
    </div>
</div>
