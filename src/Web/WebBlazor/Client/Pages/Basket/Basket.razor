@page "/basket"

<div class="mb-5">
    <div class="esh-basket">
        <div class="container">
            <h1 class="mb-4 mt-5">[ Shopping Bag ]</h1>
            <div class="alert alert-warning" role="alert" hidden="@(!errorUpdate)">
                Error updating basket items, please try later on
            </div>
            <div class="row">
                <div class="col-6 col-md-8 col-lg-9">
                    <div class="esh-basket-items row">
                        @foreach (var item in basket.Items)
                        {
                            <div class="col-12 col-md-6 col-lg-4">
                                <article class="esh-basket-item">
                                    <div class="esh-basket-thumbnail-wrapper">
                                        <div class="esh-basket-delete" @onclick="e => DeleteItem(item.Id)">
                                            <img class="esh-basket-delete-svg" src="assets/images/delete.svg" />
                                        </div>
                                        <img class="esh-basket-thumbnail" src="@item.PictureUrl" />
                                    </div>
                                    <div class="esh-basket-title">@item.ProductName</div>
                                    <div class="esh-basket-description divider d-flex align-items-center justify-content-between">
                                        <div>$ @item.UnitPrice.ToString("N2")</div>
                                        <div class="esh-basket-buttons d-flex justify-content-center">
                                            <button class="esh-basket-button @(item.Quantity == 1 ? "is-disabled" : "")" @onclick="e => ItemQuantityChanged(item, item.Quantity - 1)">
                                                <img class="esh-basket-button-svg" src="assets/images/minus.svg" />
                                            </button>
                                            <div class="esh-basket-quantity">@item.Quantity</div>
                                            <button class="esh-basket-button" @onclick="e => ItemQuantityChanged(item, item.Quantity + 1)">
                                                <img class="esh-basket-button-svg" src="assets/images/plus.svg" />
                                            </button>
                                        </div>
                                        <div class="esh-basket-price text-right">$ @Math.Round(item.UnitPrice * item.Quantity, 2).ToString("N2")</div>
                                    </div>
                                    @if (item.OldUnitPrice > 0)
                                    {
                                        <div>
                                            &nbsp;Note that the price of this article changed in our Catalog. The old price when you originally added it to the basket was $ @item.OldUnitPrice
                                        </div>
                                    }
                                </article>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="esh-basket-checkout p-4">
                        <h2 class="esh-basket-checkout-title">Your shopping bag</h2>
                        <div class="mb-3 u-text-sm">(@(basket?.Items?.Count ?? 0) items)</div>
                        <div class="d-flex justify-content-between align-items-center font-weight-bolder">
                            <div>TOTAL</div>
                            <div>$@basket.Total().ToString("N2")</div>
                        </div>
                    </div>
                    <div class="divider u-background-brightest p-4">
                        <div>
                            <button class="btn btn-primary u-width-100 u-minwidth-unset" disabled=@(!basket.Items.Any()) @onclick="CheckOut">Checkout</button>
                        </div>
                    </div>
                    <div class="p-4">
                        <a class="btn btn-secondary u-width-100 u-minwidth-unset" href="catalog">Continue Shopping</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
